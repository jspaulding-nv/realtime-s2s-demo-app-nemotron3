# Copy this file to .env. Never commit the real NGC key.
NGC_API_KEY=

# Shared persistent model cache and GPU selection for Docker Compose.
LOCAL_NIM_CACHE=./.cache/nim
GPU_ID=0

# Pinned NGC releases used for the Nemotron 3 evaluation.
ASR_IMAGE=nvcr.io/nim/nvidia/nemotron-asr-streaming:1.2.0
NMT_IMAGE=nvcr.io/nim/nvidia/riva-translate-1_6b:1.5.2
TTS_IMAGE=nvcr.io/nim/nvidia/magpie-tts-multilingual:1.7.0
# Default-off Chatterbox comparison arm. It is not wired into NMT.
CHATTERBOX_TTS_IMAGE=nvcr.io/nim/nvidia/chatterbox-tts-multilingual:1.0.0@sha256:fec12c0c6d0af511d66999daa3a824d176fb3bbc11a86ff071330726c4952cc6
# Optional immutable local/registry digests for experiment provenance.
ASR_IMAGE_DIGEST=
NMT_IMAGE_DIGEST=
TTS_IMAGE_DIGEST=
CHATTERBOX_TTS_IMAGE_DIGEST=sha256:fec12c0c6d0af511d66999daa3a824d176fb3bbc11a86ff071330726c4952cc6
ASR_NIM_TAGS_SELECTOR=name=nemotron-asr-streaming,type=en-US,batch_size=32
# The proven NMT launch uses no explicit NIM_TAGS_SELECTOR. If an external
# deployment selects a profile, record the exact applied value here.
NMT_PROFILE=
TTS_NIM_TAGS_SELECTOR=name=magpie-tts-multilingual,batch_size=8
CHATTERBOX_TTS_NIM_TAGS_SELECTOR=name=chatterbox-tts-multilingual

# Optional host-port overrides.
NMT_HTTP_PORT=9001
NMT_GRPC_PORT=50051
ASR_HTTP_PORT=9002
ASR_GRPC_PORT=50052
TTS_HTTP_PORT=9003
TTS_GRPC_PORT=50053
CHATTERBOX_TTS_HTTP_PORT=9004
CHATTERBOX_TTS_GRPC_PORT=50054

# Application connection and Nemotron endpointing settings.
RIVA_URI=localhost:50051
RIVA_ASR_URI=localhost:50052
RIVA_TTS_URI=localhost:50053
RIVA_NMT_MODEL=megatronnmt_any_any_1b
RIVA_SOURCE_LANGUAGE=en-US
RIVA_TARGET_LANGUAGE=es-US
RIVA_EOU_MS=800
RIVA_ASR_WORD_TIMES=0
RIVA_VERBOSE_CHUNKS=0

# Local, untracked evaluation audio. See test_audio/README.md.
S2S_TEST_AUDIO_DIR=./test_audio

# Experimental staged-pipeline segmentation safety valves. These are starting
# values to measure, not production latency guarantees.
STAGED_SEGMENT_MAX_CHARS=240
STAGED_SEGMENT_MAX_AGE_MS=2000
STAGED_ASR_EVENT_QUEUE_MAXSIZE=32
STAGED_NMT_QUEUE_MAXSIZE=4
STAGED_TTS_QUEUE_MAXSIZE=4
STAGED_OUTPUT_QUEUE_MAXSIZE=4
STAGED_NMT_RPC_TIMEOUT_SECONDS=15
STAGED_TTS_RPC_TIMEOUT_SECONDS=60
STAGED_TTS_MAX_SEGMENT_AUDIO_SECONDS=60
# One retry is allowed only for a server-side gRPC UNKNOWN. Atomic synthesis
# and the tiny-target fallback keep failed-attempt PCM private. Normal
# incremental synthesis can retry only before its first acknowledged frame.
STAGED_TTS_MAX_RETRIES=1
# Default-off measurement only. When enabled, retain TTS response timing and
# byte counts without PCM, text, or response metadata. With schema-3
# incremental publication also enabled, this activates the privacy-safe
# worker/event-loop/output/WebSocket publisher-handoff diagnostic.
STAGED_TTS_RESPONSE_CHUNK_TELEMETRY=0
# Default-off schema-v3 experiment. It forwards frame-aligned PCM while one
# TTS RPC is active. Keep post-NMT splitting disabled when this is enabled.
STAGED_TTS_INCREMENTAL_PUBLISH=0
STAGED_TTS_INCREMENTAL_FRAME_MS=500
# Keep tiny validated targets private until their RPC succeeds so the existing
# one-time UNKNOWN retry remains safe. Four characters protects the observed
# two-character failure plus common tiny outputs; zero disables the fallback.
STAGED_TTS_INCREMENTAL_ATOMIC_FALLBACK_MAX_CHARS=4
# Default-off post-NMT TTS splitting. Set the maximum to 40, 45, or 60 only
# for the matched canary; zero preserves one TTS call per NMT parent.
STAGED_TTS_SUBSEGMENT_MAX_CHARS=0
# Packing preference for tiny adjacent clauses. It is not a hard minimum.
STAGED_TTS_SUBSEGMENT_MIN_CHARS=12
STAGED_CLOSE_TIMEOUT_SECONDS=10

# Default-off WebSocket feature flag. Keep monolithic for the prior Riva S2S
# path; set staged only for the direct ASR -> NMT -> TTS evaluation path. The
# standalone staged_pipeline_smoke.py always selects the staged orchestrator.
S2S_PIPELINE_MODE=monolithic
